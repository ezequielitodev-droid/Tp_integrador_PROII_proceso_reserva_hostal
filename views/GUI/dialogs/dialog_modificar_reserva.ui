        <property name="styleSheet">
         <string notr="true">
          QCheckBox {
              color: #FFFFFF;
              font-weight: bold;
              font-size: 12px;
              background: transparent;
          }
          QCheckBox::indicator {
              width: 16px;
              height: 16px;
              border-radius: 3px;
              border: 1px solid #555555;
              background-color: #FFFFFF;
          }
          QCheckBox::indicator:checked {
              background-color: #D65B5B;
              border: 1px solid #D65B5B;
          }
         </string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

