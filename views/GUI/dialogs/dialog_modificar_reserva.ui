  <property name="styleSheet">
   <string notr="true">
    QDialog {
        background-color: #323232;
        color: #FFFFFF;
        font-family: Segoe UI;
    }
    QLabel {
        color: #E2E8F0;
        font-weight: bold;
        font-size: 12px;
    }
    QDateEdit {
        background-color: #FFFFFF;
        color: #263445;
        border: 1px solid #232323;
        border-radius: 5px;
        padding: 6px;
        font-size: 12px;
    }
    QPushButton {
        background-color: #FDB93B;
        color: #232323;
        border: none;
        border-radius: 6px;
        padding: 8px 14px;
        font-weight: bold;
    }
    QPushButton:hover {
        background-color: #e5a532;
    }
    QPushButton:pressed {
        background-color: #cc922b;
    }

    /* ESTILOS PARA EL CALENDARIO DESPLEGABLE (POPUP) */
    QCalendarWidget QWidget {
        background-color: #2D2D2D;
        color: #FFFFFF;
    }
    QCalendarWidget QToolButton {
        color: #232323;
        background-color: #FDB93B;
        border-radius: 4px;
        margin: 2px;
        padding: 4px;
        font-weight: bold;
    }
    QCalendarWidget QToolButton:hover {
        background-color: #e5a532;
    }
    QCalendarWidget QMenu {
        background-color: #323232;
        color: #FFFFFF;
    }
    QCalendarWidget QSpinBox {
        background-color: #FFFFFF;
        color: #263445;
        selection-background-color: #FDB93B;
    }
    QCalendarWidget QWidget#qt_calendar_navigationbar {
        background-color: #3B3B3B;
    }
    QCalendarWidget QAbstractItemView {
        background-color: #242524;
        color: #FFFFFF;
        selection-background-color: #FDB93B;
        selection-color: #232323;
    }
   </string>
  </property>
