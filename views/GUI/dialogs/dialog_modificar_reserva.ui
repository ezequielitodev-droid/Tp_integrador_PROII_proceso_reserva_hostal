    </widget>
   </item>

   <!-- SECCIÓN FECHAS -->
   <item>
    <widget class="QFrame" name="frame_fechas">
     <property name="styleSheet">
      <string notr="true">
       QFrame {
           background-color: #3B3B3B;
           border: 1px solid #232323;
           border-radius: 8px;
       }
      </string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_fechas">
      <item>
       <layout class="QHBoxLayout" name="layout_fechas">
