        </property>
        <property name="styleSheet">
         <string notr="true">color: #FDB93B; font-size: 13px;</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layout_fechas">
        <item>
         <widget class="QLabel" name="lbl_fecha_ingreso"><property name="text"><string>Ingreso:</string></property></widget>
        </item>
        <item>
         <widget class="QDateEdit" name="input_fecha_ingreso">
          <property name="calendarPopup"><bool>true</bool></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lbl_fecha_salida"><property name="text"><string>Salida:</string></property></widget>
        </item>
        <item>
         <widget class="QDateEdit" name="input_fecha_salida">
          <property name="calendarPopup"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

   <!-- SECCIÓN 3: HUÉSPEDES Y ASIGNACIÓN DE HABITACIONES -->
   <item>
