  </property>
  <property name="windowTitle">
   <string>Crear Nueva Reserva</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QDialog {
        background-color: #323232;
        color: #FFFFFF;
        font-family: Segoe UI;
    }
    QLabel {
        color: #E2E8F0;
        font-weight: bold;
        font-size: 12px;
    }
    QLineEdit, QDateEdit {
        background-color: #FFFFFF;
        color: #263445;
        border: 1px solid #232323;
        border-radius: 5px;
        padding: 6px;
        font-size: 12px;
    }
    QPushButton {
        background-color: #FDB93B;
        color: #232323;
        border: none;
        border-radius: 6px;
        padding: 8px 14px;
        font-weight: bold;
    }
    QPushButton:hover {
        background-color: #e5a532;
    }
    QPushButton:pressed {
        background-color: #cc922b;
    }

    /* ESTILOS PARA EL CALENDARIO DESPLEGABLE (POPUP) */
    QCalendarWidget QWidget {
        background-color: #2D2D2D;
        color: #FFFFFF;
    }
    /* Barra de navegación superior (mes y año) */
    QCalendarWidget QToolButton {
        color: #232323;
        background-color: #FDB93B;
        border-radius: 4px;
        margin: 2px;
        padding: 4px;
        font-weight: bold;
    }
    QCalendarWidget QToolButton:hover {
        background-color: #e5a532;
    }
    QCalendarWidget QMenu {
        background-color: #323232;
        color: #FFFFFF;
    }
    QCalendarWidget QSpinBox {
        background-color: #FFFFFF;
        color: #263445;
        selection-background-color: #FDB93B;
    }
    /* Días de la semana (Lu, Ma, Mi...) */
    QCalendarWidget QWidget#qt_calendar_navigationbar {
        background-color: #3B3B3B;
    }
    QCalendarWidget QAbstractItemView {
        background-color: #242524;
        color: #FFFFFF;
        selection-background-color: #FDB93B;
        selection-color: #232323;
    }
    QCalendarWidget QAbstractItemView:enabled {
        color: #FFFFFF;
    }
   </string>
  </property>
  <layout class="QVBoxLayout" name="layout_principal">
   <property name="spacing">
    <number>15</number>
   </property>
   <property name="leftMargin">
    <number>20</number>
   </property>
   <property name="topMargin">
    <number>20</number>
   </property>
   <property name="rightMargin">
    <number>20</number>
   </property>
   <property name="bottomMargin">
    <number>20</number>
   </property>

   <!-- TÍTULO -->
   <item>
    <widget class="QLabel" name="label_titulo">
     <property name="text">
      <string>Registrar Nueva Reserva</string>
     </property>
     <property name="styleSheet">
      <string notr="true">font-size: 20px; color: #FFFFFF;</string>
     </property>
    </widget>
   </item>

   <!-- SECCIÓN 1: DATOS DEL CLIENTE TITULAR -->
   <item>
    <widget class="QFrame" name="frame_cliente">
     <property name="styleSheet">
      <string notr="true">
       QFrame {
           background-color: #3B3B3B;
           border: 1px solid #232323;
           border-radius: 8px;
       }
      </string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_cliente">
      <item>
       <widget class="QLabel" name="label_seccion_cliente">
        <property name="text">
         <string>Datos del Cliente Responsable (Obligatorios)</string>
        </property>
        <property name="styleSheet">
         <string notr="true">color: #FDB93B; font-size: 13px;</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QGridLayout" name="grid_cliente">
        <item row="0" column="0">
         <widget class="QLabel" name="lbl_nombre"><property name="text"><string>Nombre:</string></property></widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="input_cliente_nombre"/>
        </item>
        <item row="0" column="2">
         <widget class="QLabel" name="lbl_apellido"><property name="text"><string>Apellido:</string></property></widget>
        </item>
        <item row="0" column="3">
         <widget class="QLineEdit" name="input_cliente_apellido"/>
        </item>

        <item row="1" column="0">
         <widget class="QLabel" name="lbl_dni"><property name="text"><string>DNI:</string></property></widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="input_cliente_dni"/>
        </item>
        <item row="1" column="2">
         <widget class="QLabel" name="lbl_telefono"><property name="text"><string>Teléfono:</string></property></widget>
        </item>
        <item row="1" column="3">
         <widget class="QLineEdit" name="input_cliente_telefono"/>
        </item>

        <item row="2" column="0">
         <widget class="QLabel" name="lbl_correo"><property name="text"><string>Correo:</string></property></widget>
        </item>
        <item row="2" column="1" colspan="3">
         <widget class="QLineEdit" name="input_cliente_correo"/>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

   <!-- SECCIÓN 2: FECHAS DE LA RESERVA -->
   <item>
    <widget class="QFrame" name="frame_fechas">
     <property name="styleSheet">
      <string notr="true">
       QFrame {
           background-color: #3B3B3B;
           border: 1px solid #232323;
           border-radius: 8px;
       }
      </string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_fechas">
      <item>
